{
  "version": 1,
  "kind": "browser-output-semantics",
  "description": "Browser-owned output behavior and persistence examples.",
  "cases": [
    {
      "applicationRelayDeadlineSeconds": "8",
      "authorityValidationMayContinueAfterPickerStart": true,
      "backgroundCompletionCannotInvokeAction": true,
      "bindRechecks": [
        "projection-epoch",
        "shape-proof",
        "artifact-offer",
        "capability-facts"
      ],
      "events": [
        {
          "event": "background-projection",
          "picker": "forbidden",
          "startsP2P": false
        },
        {
          "event": "preview-click",
          "picker": "none",
          "startsP2P": true
        },
        {
          "event": "final-artifact-action-without-picker",
          "picker": "none",
          "startsP2P": true
        },
        {
          "event": "final-artifact-action-with-picker",
          "picker": "synchronous-before-click-stack-unwinds",
          "startsP2P": true
        }
      ],
      "name": "artifact-action-picker-timing",
      "p2pStartSeconds": "0"
    },
    {
      "cuts": [
        {
          "cut": "after-data-write",
          "newGenerationSelectable": false
        },
        {
          "cut": "after-data-flush",
          "newGenerationSelectable": false
        },
        {
          "cut": "after-candidate-record-write",
          "newGenerationSelectable": false
        },
        {
          "cut": "after-candidate-record-flush",
          "newGenerationSelectable": false
        },
        {
          "cut": "after-verified-record-install",
          "newGenerationSelectable": false
        },
        {
          "cut": "after-reopen-verify",
          "newGenerationSelectable": true
        }
      ],
      "name": "file-checkpoint-v2-crash-cuts",
      "namespace": ".windshare-output/checkpoints-v2",
      "order": [
        "data-write",
        "data-flush",
        "candidate-record-write",
        "candidate-record-flush",
        "verified-record-install",
        "reopen-verify"
      ],
      "ownershipMarker": "windshare/file-checkpoint/v2",
      "selectionAuthority": "highest-reopened-verified-generation"
    },
    {
      "name": "artifact-plan-guarantee-matrix",
      "rows": [
        {
          "artifact": "directory-tree",
          "binding": "named-container-entry",
          "completion": "prefix-visible-partial-legal",
          "guaranteeProfiles": [
            "native-tree",
            "fsa-tree"
          ],
          "layout": "single-file-or-result-root",
          "plan": "direct-tree",
          "preparation": "none"
        },
        {
          "artifact": "directory-tree",
          "binding": "container-root",
          "completion": "prefix-visible",
          "guaranteeProfiles": [
            "native-tree"
          ],
          "layout": "catalog-root",
          "plan": "direct-tree",
          "preparation": "none"
        },
        {
          "artifact": "original-file",
          "binding": "origin-private-workspace",
          "completion": "sealed-then-waiting-to-save",
          "guaranteeProfiles": [
            "managed-atomic",
            "browser-handoff"
          ],
          "layout": "single-file-proof",
          "plan": "workspace-then-publish",
          "preparation": "none"
        },
        {
          "artifact": "zip-archive",
          "binding": "origin-private-workspace",
          "completion": "complete-only-sealed-then-waiting-to-save",
          "guaranteeProfiles": [
            "managed-atomic",
            "browser-handoff"
          ],
          "layout": "result-root",
          "plan": "workspace-then-publish",
          "preparation": "none"
        },
        {
          "artifact": "original-file-or-zip-archive",
          "binding": "portable",
          "completion": "download-started-only",
          "guaranteeProfiles": [
            "browser-handoff"
          ],
          "layout": "explicit-artifact",
          "plan": "portable-handoff",
          "preparation": "exact-artifact"
        }
      ]
    },
    {
      "admissionChecks": [
        "durable-metadata-at-activation",
        "object-high-water-growth",
        "cross-tab-outstanding-growth",
        "quota-minus-usage-minus-reserve"
      ],
      "components": [
        "uniqueRawBytes",
        "durableMetadataBytes"
      ],
      "derivedPeak": "checked-sum-components",
      "evidence": {
        "progressive-zip": 3,
        "single-file": 1
      },
      "limits": {
        "DEFAULT_PORTABLE_HANDOFF_ARTIFACT_LIMIT": "67108864",
        "MINIMUM_OPFS_QUOTA_RESERVE": "536870912"
      },
      "name": "workspace-budget-v1",
      "ownedObjectCountedOnce": true,
      "quotaEstimateIsReservation": false,
      "quotaUnavailable": "optimistic-incremental-admission"
    },
    {
      "cases": [
        {
          "action": "abort-artifact",
          "artifactOutcome": "failed",
          "failure": "discovery",
          "partialResult": false,
          "publicationAllowed": false
        },
        {
          "action": "abort-artifact",
          "artifactOutcome": "failed",
          "failure": "member-before-header",
          "partialResult": false,
          "publicationAllowed": false
        },
        {
          "action": "abort-artifact",
          "artifactOutcome": "failed",
          "failure": "member-after-header",
          "partialResult": false,
          "publicationAllowed": false
        }
      ],
      "completeness": "complete-only",
      "encoding": "store",
      "name": "zip-complete-only"
    },
    {
      "completeArtifactsExclude": [
        "partial-directory"
      ],
      "domain": "windshare/receive-lifecycle-state/v2",
      "handoffNeverMeans": "published",
      "name": "receive-lifecycle-v2",
      "nonterminalRecoveryStates": [
        {
          "byte": 15,
          "plans": [
            "workspace-then-publish",
            "portable-handoff"
          ],
          "state": "download-started"
        }
      ],
      "publishedCleanupPendingRemains": "published",
      "restartReasons": {
        "content-session-ended": 5,
        "portable-aborted": 2,
        "preparation-invalidated": 4,
        "source-revision-changed": 3
      },
      "resumableReceivePayloadKinds": {
        "file-set": 1,
        "opfs-zip": 3
      },
      "schemaVersion": 2,
      "terminalStates": [
        {
          "byte": 14,
          "plans": [
            "direct-tree",
            "workspace-then-publish"
          ],
          "state": "published"
        },
        {
          "byte": 16,
          "plans": [
            "direct-tree"
          ],
          "state": "partial-directory"
        },
        {
          "byte": 17,
          "plans": [
            "portable-handoff"
          ],
          "state": "restart-required"
        },
        {
          "byte": 18,
          "plans": [
            "direct-tree",
            "workspace-then-publish",
            "portable-handoff"
          ],
          "state": "discarded"
        },
        {
          "byte": 20,
          "plans": [
            "direct-tree",
            "workspace-then-publish"
          ],
          "state": "needs-attention"
        }
      ]
    }
  ]
}
