{
  "name": "windshare-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "forbidden": "node ../scripts/ci/web-forbidden.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser:contract": "playwright test --config playwright.contract.config.ts --project chromium-short",
    "test:browser:contract:short": "playwright test --config playwright.contract.config.ts --project chromium-short",
    "test:browser:contract:cross": "playwright test --config playwright.contract.config.ts --project firefox-short --project webkit-short",
    "test:browser:contract:periodic": "playwright test --config playwright.contract.config.ts --project chromium-periodic",
    "test:browser:network": "playwright test --config playwright.network.config.ts --project chromium",
    "test:browser:interop": "node scripts/browser-network-matrix/run-interop.mjs",
    "test:browser:cross": "playwright test --config playwright.cross-browser.config.ts",
    "test:browser:smoke": "playwright test --config playwright.smoke.config.ts --project chromium",
    "test:browser:progressive": "playwright test --config playwright.progressive.config.ts --project chromium"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "cborg": "5.1.7",
    "mp4box": "2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@zip.js/zip.js": "2.8.26",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
