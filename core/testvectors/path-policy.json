{
  "version": 1,
  "kind": "path-policy",
  "description": "Logical catalog paths use Unicode 15 NFC and full-fold sibling identity. Structural and control-character violations are rejected. Destination-specific names remain transferable; portableOutput describes conventional disk-name compatibility, independently of catalog validity.",
  "cases": [
    {
      "name": "policy-version",
      "policyVersion": "windshare/path/v2-unicode-15.0.0",
      "unicodeVersion": "15.0.0"
    },
    {
      "name": "ascii",
      "input": "tree/readme.txt",
      "expected": "valid",
      "canonical": "tree/readme.txt",
      "collisionKey": "tree/readme.txt"
    },
    {
      "name": "sharp-s-uppercase",
      "input": "ẞ.txt",
      "expected": "valid",
      "canonical": "ẞ.txt",
      "collisionKey": "ss.txt",
      "collisionGroup": "sharp-s"
    },
    {
      "name": "sharp-s-expanded",
      "input": "ss.txt",
      "expected": "valid",
      "canonical": "ss.txt",
      "collisionKey": "ss.txt",
      "collisionGroup": "sharp-s"
    },
    {
      "name": "turkish-ascii-uppercase-i",
      "input": "I.txt",
      "expected": "valid",
      "canonical": "I.txt",
      "collisionKey": "i.txt",
      "collisionGroup": "turkish-ascii-i"
    },
    {
      "name": "turkish-ascii-lowercase-i",
      "input": "i.txt",
      "expected": "valid",
      "canonical": "i.txt",
      "collisionKey": "i.txt",
      "collisionGroup": "turkish-ascii-i"
    },
    {
      "name": "turkish-dotted-uppercase-i",
      "input": "İ.txt",
      "expected": "valid",
      "canonical": "İ.txt",
      "collisionKey": "i̇.txt",
      "collisionGroup": "turkish-dotted-i"
    },
    {
      "name": "turkish-dotted-expanded",
      "input": "i̇.txt",
      "expected": "valid",
      "canonical": "i̇.txt",
      "collisionKey": "i̇.txt",
      "collisionGroup": "turkish-dotted-i"
    },
    {
      "name": "turkish-dotless-i",
      "input": "ı.txt",
      "expected": "valid",
      "canonical": "ı.txt",
      "collisionKey": "ı.txt"
    },
    {
      "name": "nfc",
      "input": "café.txt",
      "expected": "valid",
      "canonical": "café.txt",
      "collisionKey": "café.txt",
      "collisionGroup": "nfc-nfd"
    },
    {
      "name": "nfd-canonicalized",
      "input": "café.txt",
      "expected": "valid",
      "canonical": "café.txt",
      "collisionKey": "café.txt",
      "collisionGroup": "nfc-nfd"
    },
    {
      "name": "post-policy-composition-sequence",
      "input": "𐗉.txt",
      "expected": "valid",
      "canonical": "𐗉.txt",
      "collisionKey": "𐗉.txt"
    },
    {
      "name": "post-policy-composite",
      "input": "𐗉.txt",
      "expected": "valid",
      "canonical": "𐗉.txt",
      "collisionKey": "𐗉.txt"
    },
    {
      "name": "nested-journal-name",
      "input": "tree/.wsresume-part",
      "expected": "valid",
      "canonical": "tree/.wsresume-part",
      "collisionKey": "tree/.wsresume-part"
    },
    {
      "name": "folded-journal-prefix",
      "input": ".WSRESUME-part",
      "expected": "invalid-path"
    },
    {
      "name": "full-fold-journal-prefix",
      "input": ".wſresume-part",
      "expected": "invalid-path"
    },
    {
      "name": "bidi-format-character",
      "input": "safe/evil‮txt.exe",
      "expected": "invalid-path"
    },
    {
      "name": "zero-width-joiner",
      "input": "safe/a‍b",
      "expected": "invalid-path"
    },
    {
      "name": "control-character",
      "input": "safe/line\nbreak",
      "expected": "invalid-path"
    },
    {
      "name": "superscript-com-device",
      "input": "COM¹.txt",
      "expected": "valid",
      "canonical": "COM¹.txt",
      "collisionKey": "com¹.txt",
      "portableOutput": false
    },
    {
      "name": "superscript-lpt-device",
      "input": "lpt²",
      "expected": "valid",
      "canonical": "lpt²",
      "collisionKey": "lpt²",
      "portableOutput": false
    },
    {
      "name": "console-input-device",
      "input": "CONIN$",
      "expected": "valid",
      "canonical": "CONIN$",
      "collisionKey": "conin$",
      "portableOutput": false
    },
    {
      "name": "console-output-device",
      "input": "conout$.log",
      "expected": "valid",
      "canonical": "conout$.log",
      "collisionKey": "conout$.log",
      "portableOutput": false
    },
    {
      "name": "device-stem-trailing-space",
      "input": "NUL .txt",
      "expected": "valid",
      "canonical": "NUL .txt",
      "collisionKey": "nul .txt",
      "portableOutput": false
    },
    {
      "name": "nested-device-stem-trailing-spaces",
      "input": "safe/com1  .tar.gz",
      "expected": "valid",
      "canonical": "safe/com1  .tar.gz",
      "collisionKey": "safe/com1  .tar.gz",
      "portableOutput": false
    },
    {
      "name": "spaced-device-stem-and-extension",
      "input": "CON . txt",
      "expected": "valid",
      "canonical": "CON . txt",
      "collisionKey": "con . txt",
      "portableOutput": false
    },
    {
      "name": "console-device-stem-trailing-space",
      "input": "conin$ .log",
      "expected": "valid",
      "canonical": "conin$ .log",
      "collisionKey": "conin$ .log",
      "portableOutput": false
    },
    {
      "name": "superscript-device-stem-trailing-space",
      "input": "COM¹ .log",
      "expected": "valid",
      "canonical": "COM¹ .log",
      "collisionKey": "com¹ .log",
      "portableOutput": false
    },
    {
      "name": "device-stem-trailing-nbsp-is-not-trimmed",
      "input": "NUL .txt",
      "expected": "valid",
      "canonical": "NUL .txt",
      "collisionKey": "nul .txt",
      "portableOutput": true
    },
    {
      "name": "device-stem-leading-space-is-not-trimmed",
      "input": " NUL.txt",
      "expected": "valid",
      "canonical": " NUL.txt",
      "collisionKey": " nul.txt",
      "portableOutput": true
    },
    {
      "name": "non-device-stem-trailing-space",
      "input": "NULx .txt",
      "expected": "valid",
      "canonical": "NULx .txt",
      "collisionKey": "nulx .txt",
      "portableOutput": true
    },
    {
      "name": "destination-specific-trailing-space ",
      "input": "tree/trailing-space ",
      "expected": "valid",
      "canonical": "tree/trailing-space ",
      "collisionKey": "tree/trailing-space ",
      "portableOutput": false
    },
    {
      "name": "destination-specific-trailing-dot.",
      "input": "tree/trailing-dot.",
      "expected": "valid",
      "canonical": "tree/trailing-dot.",
      "collisionKey": "tree/trailing-dot.",
      "portableOutput": false
    },
    {
      "name": "destination-specific-question?.txt",
      "input": "tree/question?.txt",
      "expected": "valid",
      "canonical": "tree/question?.txt",
      "collisionKey": "tree/question?.txt",
      "portableOutput": false
    },
    {
      "name": "destination-specific-time:12.txt",
      "input": "tree/time:12.txt",
      "expected": "invalid-path"
    },
    {
      "name": "destination-specific-C:drive",
      "input": "tree/C:drive",
      "expected": "invalid-path"
    },
    {
      "name": "destination-specific-CON",
      "input": "tree/CON",
      "expected": "valid",
      "canonical": "tree/CON",
      "collisionKey": "tree/con",
      "portableOutput": false
    },
    {
      "name": "destination-specific-NUL",
      "input": "tree/NUL",
      "expected": "valid",
      "canonical": "tree/NUL",
      "collisionKey": "tree/nul",
      "portableOutput": false
    }
  ]
}
