new file mode 100644
--- /dev/null
+++ b/sctp/research_batch.go
@@ -0,0 +1,17 @@
+package sctp
+
+import("fmt";"os";"strconv";"sync/atomic";"time")
+var researchBatchSize,_=strconv.Atoi(os.Getenv("WS_PROBE_BATCH"))
+type researchDatagramWriter interface { WriteDatagrams([][]byte) error }
+func(a *Association) researchSendBatch(packets [][]byte)(bool,error){
+ if researchBatchSize<2||len(packets)<2{return false,nil}
+ writer,ok:=a.netConn.(researchDatagramWriter);if !ok{return false,nil}
+ for _,p:=range packets {if len(p)>int(commonHeaderSize)&&p[commonHeaderSize]==byte(ctAbort){return false,nil}}
+ for start:=0;start<len(packets);start+=researchBatchSize {
+  batch:=packets[start:min(start+researchBatchSize,len(packets))]
+  at:=time.Now();err:=writer.WriteDatagrams(batch);atomic.AddUint64(&a.researchWriteNanos,uint64(time.Since(at)))
+  if err!=nil{fmt.Fprintln(os.Stderr,"research batch failure:",err);return true,err}
+  for _,packet:=range batch {atomic.AddUint64(&a.bytesSent,uint64(len(packet)));a.stats.incPacketsSent()}
+ }
+ return true,nil
+}
