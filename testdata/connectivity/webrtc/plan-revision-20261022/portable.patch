diff --git a/dtls/research_context.go b/dtls/research_context.go
new file mode 100644
--- /dev/null
+++ b/dtls/research_context.go
@@ -0,0 +1,18 @@
+package dtls
+import ("context";"os")
+var researchStandardContext=os.Getenv("WS_PROBE_STANDARD_CONTEXT")=="1"
+type researchCloseContext struct { context.Context }
+func(c researchCloseContext) Err() error { return context.Cause(c.Context) }
+// A standard cancel context lets downstream AfterFunc register callbacks without
+// a second waiter goroutine for this custom connection/deadline combination.
+func(c *Conn) researchContextWithClose(parent context.Context)(context.Context,context.CancelFunc){
+ ctx,cancel:=context.WithCancelCause(context.Background())
+ go func(){
+  select{
+  case <-c.closed.Done():cancel(context.Canceled)
+  case <-parent.Done():err:=parent.Err();if err==nil{err=context.DeadlineExceeded};cancel(err)
+  case <-ctx.Done():
+  }
+ }()
+ return researchCloseContext{ctx},func(){cancel(context.Canceled)}
+}
