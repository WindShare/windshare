diff --git a/webrtc/research_link.go b/webrtc/research_link.go
new file mode 100644
--- /dev/null
+++ b/webrtc/research_link.go
@@ -0,0 +1,88 @@
+package webrtc
+
+import (
+ "net"
+ "os"
+ "strconv"
+ "sync"
+ "time"
+)
+
+const researchQueuePackets = 32768
+type researchPacket struct { data []byte; ready time.Time; err error }
+type researchLink struct {
+ net.Conn
+ delay time.Duration
+ queue chan researchPacket
+ done chan struct{}
+ once sync.Once
+ rate float64
+ burst int
+ used int
+ epoch time.Time
+ loss float64
+ sequence uint64
+}
+func researchBurst() int { n:=int(researchNumber("WS_PROBE_BURST"));if n>=1200{return n};return 32768 }
+func researchMTU() uint32 { n:=uint32(researchNumber("WS_PROBE_MTU"));if n>=1000 && n<=1400{return n};return sctpOutboundMTU }
+func researchNumber(name string) float64 { v,_:=strconv.ParseFloat(os.Getenv(name),64); return v }
+func newResearchLink(conn net.Conn) net.Conn {
+ delay:=time.Duration(researchNumber("WS_PROBE_ACK_DELAY_MS")*float64(time.Millisecond))
+ rate:=researchNumber("WS_PROBE_PACE_MBPS")*1e6
+ loss:=researchNumber("WS_PROBE_LOSS")
+ if delay==0 && rate==0 && loss==0 { return conn }
+ p:=&researchLink{Conn:conn,delay:delay,rate:rate,loss:loss,burst:researchBurst(),done:make(chan struct{})}
+ if delay>0 {
+  p.queue=make(chan researchPacket,researchQueuePackets)
+  go func(){
+   defer close(p.queue)
+   buffer:=make([]byte,65536)
+   for {
+    n,err:=conn.Read(buffer)
+    packet:=researchPacket{data:append([]byte(nil),buffer[:n]...),ready:time.Now().Add(delay),err:err}
+    select { case p.queue<-packet: case <-p.done:return }
+    if err!=nil{return}
+   }
+  }()
+ }
+ return p
+}
+func(p *researchLink) Read(b []byte)(int,error) {
+ if p.delay==0{return p.Conn.Read(b)}
+ var packet researchPacket
+ select {case v,ok:=<-p.queue: if !ok{return 0,net.ErrClosed}; packet=v;case <-p.done:return 0,net.ErrClosed}
+ if wait:=time.Until(packet.ready);wait>0 {
+  timer:=time.NewTimer(wait)
+  select{case <-timer.C:case <-p.done:timer.Stop();return 0,net.ErrClosed}
+ }
+ return copy(b,packet.data),packet.err
+}
+func(p *researchLink) Write(b []byte)(int,error) {
+ if p.rate>0 {
+  if p.epoch.IsZero(){p.epoch=time.Now()}
+  if p.used+len(b)>p.burst {
+   target:=p.epoch.Add(time.Duration(float64(p.used)/p.rate*float64(time.Second)))
+   if wait:=time.Until(target);wait>0 {
+    timer:=time.NewTimer(wait)
+    select{case <-timer.C:case <-p.done:timer.Stop();return 0,net.ErrClosed}
+   }
+   p.epoch=time.Now();p.used=0
+  }
+  p.used+=len(b)
+ }
+ p.sequence++
+ if p.loss>0 {
+  v:=p.sequence*0x9e3779b97f4a7c15
+  v=(v^(v>>30))*0xbf58476d1ce4e5b9
+  if float64(uint32(v>>32))/4294967296.0<p.loss{return len(b),nil}
+ }
+ return p.Conn.Write(b)
+}
+func(p *researchLink) WriteDatagrams(packets [][]byte) error {
+ if p.rate==0 && p.loss==0 {
+  if sender,ok:=p.Conn.(interface{WriteDatagrams([][]byte)error});ok{return sender.WriteDatagrams(packets)}
+ }
+ for _,packet:=range packets{if _,err:=p.Write(packet);err!=nil{return err}}
+ return nil
+}
+func(p *researchLink) Close() error {p.once.Do(func(){close(p.done)});return p.Conn.Close()}
