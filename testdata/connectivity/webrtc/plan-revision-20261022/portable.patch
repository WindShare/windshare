@@ -0,0 +1,47 @@
+package ice
+
+import("context";"io";"net/netip";"github.com/pion/stun/v4")
+
+type researchAddrBatchWriter interface{ WriteBatchToAddrPort([][]byte,netip.AddrPort)(int,error) }
+
+func(c *Conn) WriteDatagrams(packets [][]byte) error{
+ if err:=c.agent.loop.Err();err!=nil{return err}
+ pair:=c.agent.getSelectedPair()
+ if pair==nil{for _,p:=range packets{if _,err:=c.Write(p);err!=nil{return err}};return nil}
+ for _,p:=range packets{if stun.IsMessage(p){return errWriteSTUNMessageToIceConn}}
+ sender,ok:=pair.Local.(interface{researchWriteDatagrams([][]byte,Candidate)(int,error)})
+ if !ok{for _,p:=range packets{if _,err:=c.Write(p);err!=nil{return err}};return nil}
+ n,err:=sender.researchWriteDatagrams(packets,pair.Remote)
+ if n>0{c.bytesSent.Add(uint64(n));for _,p:=range packets{if n<len(p){break};pair.UpdatePacketSent(len(p));n-=len(p)}}
+ return err
+}
+func(c *candidateBase) researchWriteDatagrams(packets [][]byte,dst Candidate)(int,error){
+ var n int
+ sender,ok:=c.conn.(researchAddrBatchWriter)
+ if ok {written,err:=sender.WriteBatchToAddrPort(packets,dst.addrPort());if written>0{c.seen(true)};return written,err}
+ for _,p:=range packets{count,err:=c.writeTo(p,dst);n+=count;if err!=nil{return n,err}}
+ return n,nil
+}
+func(c *sharedPacketConn) WriteBatchToAddrPort(packets [][]byte,addr netip.AddrPort)(int,error){
+ if c.ctx.Err()!=nil{return 0,io.ErrClosedPipe}
+ if sender,ok:=c.underlying.(researchAddrBatchWriter);ok{return sender.WriteBatchToAddrPort(packets,addr)}
+ return 0,io.ErrNoProgress
+}
+func(c *udpMuxedConn) WriteBatchToAddrPort(packets [][]byte,addr netip.AddrPort)(int,error){
+ if c.isClosed(){return 0,io.ErrClosedPipe}
+ if !addr.IsValid(){return 0,errInvalidIPAddress}
+ c.registerAddress(canonicalAddrPort(addr))
+ return c.params.Mux.researchWriteDatagrams(packets,addr)
+}
+func(m *UDPMuxDefault) researchWriteDatagrams(packets [][]byte,addr netip.AddrPort)(n int,err error){
+ if err=m.startWriteContext(context.Background());err!=nil{return 0,err}
+ defer func(){err=m.finishWrite(err)}()
+ if sender,ok:=m.params.UDPConn.(researchAddrBatchWriter);ok{return sender.WriteBatchToAddrPort(packets,addr)}
+ for _,p:=range packets{count,e:=m.addrPortConn.WriteToAddrPort(p,addr);n+=count;if e!=nil{return n,e}}
+ return n,nil
+}
+func(c *udpAddrPortConn) WriteBatchToAddrPort(packets [][]byte,addr netip.AddrPort)(int,error){
+ if sender,ok:=c.addrPortConn.(researchAddrBatchWriter);ok{return sender.WriteBatchToAddrPort(packets,addr)}
+ var n int;for _,p:=range packets{count,err:=c.addrPortConn.WriteToAddrPort(p,addr);n+=count;if err!=nil{return n,err}}
+ return n,nil
+}
diff --git a/webrtc/internal/mux/research_batch.go b/webrtc/internal/mux/research_batch.go
new file mode 100644
--- /dev/null
+++ b/webrtc/internal/mux/research_batch.go
@@ -0,0 +1,10 @@
+package mux
+import("errors";"io";"net";"github.com/pion/ice/v4")
+func(e *Endpoint) WriteDatagrams(packets [][]byte,_ net.Addr) error{
+ sender,ok:=e.mux.nextConn.(interface{WriteDatagrams([][]byte)error})
+ if !ok{for _,p:=range packets{if _,err:=e.Write(p);err!=nil{return err}};return nil}
+ err:=sender.WriteDatagrams(packets)
+ if errors.Is(err,ice.ErrNoCandidatePairs){return nil}
+ if errors.Is(err,ice.ErrClosed){return io.ErrClosedPipe}
+ return err
+}
diff --git a/dtls/research_batch.go b/dtls/research_batch.go
new file mode 100644
--- /dev/null
+++ b/dtls/research_batch.go
@@ -0,0 +1,61 @@
+package dtls
+
+import (
+ "context"
+ "errors"
+ "io"
+ "net"
+ "os"
+ "strconv"
+ "time"
+ "github.com/pion/dtls/v3/pkg/protocol"
+ "github.com/pion/dtls/v3/pkg/protocol/recordlayer"
+)
+var researchBatchSize,_=strconv.Atoi(os.Getenv("WS_PROBE_BATCH"))
+
+func(c *Conn) WriteDatagrams(payloads [][]byte) error {
+ if c.isConnectionClosed(){return ErrConnClosed}
+ select{case <-c.writeDeadline.Done():return errDeadlineExceeded;default:}
+ if err:=c.Handshake();err!=nil{return err}
+ ctx,cancel:=c.contextWithClose(c.writeDeadline);defer cancel()
+ packets:=make([]*packet,0,len(payloads))
+ for _,payload:=range payloads{
+  packets=append(packets,&packet{
+   record:&recordlayer.RecordLayer{Header:recordlayer.Header{Epoch:c.state.getLocalEpoch(),Version:protocol.Version1_2},Content:&protocol.ApplicationData{Data:payload}},
+   shouldWrapCID:len(c.state.remoteConnectionID)>0,shouldEncrypt:true,
+  })
+ }
+ return c.writePackets(ctx,packets)
+}
+func(c *Conn) researchWritePrepared(ctx context.Context, packets [][]byte, addr net.Addr) error {
+ if err:=ctx.Err();err!=nil{return err}
+ var err error
+ // This spike removes the netctx fork using its existing Conn accessor.
+ // It retains the earlier deadline adapter for comparison; production still
+ // needs context-aware native operation ownership and completion draining.
+ if sender,ok:=c.nextConn.Conn().(interface{WriteDatagrams([][]byte,net.Addr)error});ok {
+  canceled:=make(chan struct{})
+  var deadlineErr error
+  stop:=context.AfterFunc(ctx,func(){
+   deadlineErr=c.nextConn.Conn().SetWriteDeadline(time.Unix(1,0))
+   close(canceled)
+  })
+  err=sender.WriteDatagrams(packets,addr)
+  if !stop(){
+   <-canceled
+   if deadlineErr==nil{deadlineErr=c.nextConn.Conn().SetWriteDeadline(time.Time{})}
+  }
+  if e:=ctx.Err();e!=nil{err=e}
+  if err==nil&&deadlineErr!=nil{err=deadlineErr}
+ }else{
+  for _,packet:=range packets{
+   var n int
+   n,err=c.nextConn.WriteToContext(ctx,packet,addr)
+   if err==nil&&n!=len(packet){err=io.ErrShortWrite}
+   if err!=nil{break}
+  }
+ }
+ if errors.Is(err,context.Canceled)&&c.isConnectionClosed(){return ErrConnClosed}
+ if err!=nil{return netError(err)}
+ return nil
+}
