{
  "listen": "127.0.0.1:8484",
  "database": "relay.sqlite",
  "identity_file": "identity.json",
  "endpoint": "wss://relay.example.com/v2/ws",
  "origins": { "kind": "public" },
  "proxy": { "peers": ["127.0.0.1"], "header": "X-Windshare-Source-Ip" },
  "node": {
    "zone": "global",
    "services": { "relay": true, "stun": true },
    "access": { "anonymous": true },
    "bootstrap_nodes": [
      "https://cn1.ourworld.top",
      "https://us1.windshare.cc",
      "https://eu1.windshare.cc"
    ]
  }
}
