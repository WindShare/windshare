[Unit]
Description=Refresh the verified WindShare directory mirror
After=network-online.target

[Service]
Type=oneshot
User=windshare-network
ExecStart=/usr/bin/flock /srv/windshare/directory /opt/windshare-network/network-sign mirror --bundle /srv/windshare/current/web/.well-known/windshare-network --out /srv/windshare/directory/windshare-network.json
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/windshare/directory
PrivateTmp=true
