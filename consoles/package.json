{
  "name": "windshare-consoles",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev:relay": "vite --mode relay",
    "dev:network": "vite --mode network",
    "build:relay": "tsc -p relay && vite build --mode relay",
    "build:network": "tsc -p network && vite build --mode network",
    "typecheck": "tsc -p relay && tsc -p network",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-sonarjs": "4.2.0",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
